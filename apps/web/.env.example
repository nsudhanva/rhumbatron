# Copy to .env.local (Git ignores it). `clerk init` writes real development values.
# Publishable key is public and is inlined into the client bundle at build time.
VITE_CLERK_PUBLISHABLE_KEY=
# Server-only. Never import in client code. Remote environments get it from a Terraform-managed Worker secret.
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
