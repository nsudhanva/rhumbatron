# Copy to .env.local (Git ignores it). `clerk init` writes real development values.
# Public Clerk values. Vite inlines VITE_* values into the client bundle at build time.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Server-only runtime secret. Never import in client code. Never pass it as a build arg.
CLERK_SECRET_KEY=
# Origin of the core API on the internal network.
API_INTERNAL_URL=http://localhost:8787
