// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-web"
  }
}
