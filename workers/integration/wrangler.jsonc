// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // isomorphic-git and memfs need Node.js APIs (Buffer, path).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-integration",
    "AI_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "rhumbatron-models-dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhumbatron-control-local",
      "database_id": "local",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "rhumbatron-evidence-local" }],
  "queues": {
    "producers": [{ "binding": "AGENT_WAKEUPS", "queue": "rhumbatron-agent-wakeups-local" }],
    // `change.dispatch` from the Causal Router, `project.provision` and `candidate.verify` from the API.
    "consumers": [
      {
        "queue": "rhumbatron-integration-local",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "rhumbatron-dead-letter-local"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESOURCE_SHARD",
        "class_name": "ResourceShardDO",
        "script_name": "rhumbatron-coordinator"
      },
      {
        "name": "PROJECT_ROOT",
        "class_name": "ProjectRootDO",
        "script_name": "rhumbatron-coordinator"
      },
      // Candidate composition and checks run in the Project Sandbox (ADR 0012).
      { "name": "SANDBOX", "class_name": "Sandbox", "script_name": "rhumbatron-sandbox" }
    ]
  },
  // AGENTS.md section 21.1. The API starts one instance per Change (instance ID = Change ID).
  "workflows": [
    {
      "name": "rhumbatron-change-workflow-local",
      "binding": "CHANGE_WORKFLOW",
      "class_name": "ChangeWorkflow"
    },
    // AGENTS.md section 21.2. One instance per Candidate (instance ID = Candidate ID).
    {
      "name": "rhumbatron-candidate-verification-local",
      "binding": "CANDIDATE_WORKFLOW",
      "class_name": "CandidateVerificationWorkflow"
    }
  ],
  // Canonical source for managed Projects (AGENTS.md section 29). One repo per Project.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "rhumbatron-projects-local" }]
}
