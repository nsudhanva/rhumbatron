// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // isomorphic-git and memfs need Node.js APIs (Buffer, path).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-integration",
    "AI_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "rhumbatron-models-prod"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhumbatron-control-local",
      "database_id": "local",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "rhumbatron-evidence-local" }],
  // Read-through Project policy snapshot (AGENTS.md section 53); D1 project_policies is the truth.
  "kv_namespaces": [{ "binding": "CONFIG", "id": "local" }],
  "queues": {
    "producers": [
      { "binding": "AGENT_WAKEUPS", "queue": "rhumbatron-agent-wakeups-local" },
      // AGENTS.md section 20: Workflow start commands. This Worker produces and consumes them.
      { "binding": "VERIFICATION_COMMANDS", "queue": "rhumbatron-verification-local" },
      { "binding": "RELEASE_COMMANDS", "queue": "rhumbatron-release-local" }
    ],
    // `change.dispatch` and `candidate.create` from the Causal Router, `project.provision` from the API.
    "consumers": [
      {
        "queue": "rhumbatron-integration-local",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "rhumbatron-dead-letter-local"
      },
      // `verification.start` and `release.start`: instance ID = the command's idempotency key.
      {
        "queue": "rhumbatron-verification-local",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "rhumbatron-dead-letter-local"
      },
      {
        "queue": "rhumbatron-release-local",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "rhumbatron-dead-letter-local"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESOURCE_SHARD",
        "class_name": "ResourceShardDO",
        "script_name": "rhumbatron-coordinator"
      },
      {
        "name": "PROJECT_ROOT",
        "class_name": "ProjectRootDO",
        "script_name": "rhumbatron-coordinator"
      },
      // Project cleanup purges the live view and the Project's AgentDO instances (section 43).
      {
        "name": "PROJECT_VIEW",
        "class_name": "ProjectViewDO",
        "script_name": "rhumbatron-coordinator"
      },
      { "name": "AGENT", "class_name": "AgentDO", "script_name": "rhumbatron-agents" },
      // Candidate composition and checks run in the Project Sandbox (ADR 0012).
      { "name": "SANDBOX", "class_name": "Sandbox", "script_name": "rhumbatron-sandbox" }
    ]
  },
  // AGENTS.md section 21.1. The API starts one instance per Change (instance ID = Change ID).
  "workflows": [
    {
      "name": "rhumbatron-change-workflow-local",
      "binding": "CHANGE_WORKFLOW",
      "class_name": "ChangeWorkflow"
    },
    // AGENTS.md section 21.2. One instance per Candidate (instance ID = Candidate ID).
    {
      "name": "rhumbatron-candidate-verification-local",
      "binding": "CANDIDATE_WORKFLOW",
      "class_name": "CandidateVerificationWorkflow"
    },
    // AGENTS.md section 21.3. One instance per promoted generation (ID = release ID, ADR 0020).
    {
      "name": "rhumbatron-release-local",
      "binding": "RELEASE_WORKFLOW",
      "class_name": "ReleaseWorkflow"
    }
  ],
  // Canonical source for managed Projects (AGENTS.md section 29). One repo per Project.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "rhumbatron-projects-local" }],
  // Browser Run for the Candidate browser check (AGENTS.md section 35). Capped in code:
  // one session per check, at most 2 per Candidate, 500 browser-seconds per UTC day.
  "browser": { "binding": "BROWSER" }
}
