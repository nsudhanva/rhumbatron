// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-coordinator"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOT", "class_name": "ProjectRootDO" },
      { "name": "RESOURCE_SHARD", "class_name": "ResourceShardDO" },
      { "name": "PROJECT_VIEW", "class_name": "ProjectViewDO" }
    ]
  },
  // SQLite-backed Durable Objects (available on Workers Free).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRootDO", "ResourceShardDO", "ProjectViewDO"] }
  ]
}
