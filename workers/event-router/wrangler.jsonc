// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-event-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-event-router",
    // JSON array of K2 stream IDs in index order (EVENTS_00..07). Terraform sets the real IDs.
    "K2_STREAM_IDS": "[]"
  },
  // Safety-net sweep: one stream per minute (AGENTS.md section 19). Nudges handle the fast path.
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "rhumbatron-evidence-local" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhumbatron-control-local",
      "database_id": "local",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_VIEW",
        "class_name": "ProjectViewDO",
        "script_name": "rhumbatron-coordinator"
      },
      // Dead-letter consumer records `task.failed` through the Change's shard outbox (section 42.7).
      {
        "name": "RESOURCE_SHARD",
        "class_name": "ResourceShardDO",
        "script_name": "rhumbatron-coordinator"
      }
    ]
  },
  "queues": {
    "producers": [
      { "binding": "AGENT_WAKEUPS", "queue": "rhumbatron-agent-wakeups-local" },
      // The Causal Router hands newly ready Tasks to the integration Worker's dispatcher.
      { "binding": "INTEGRATION_COMMANDS", "queue": "rhumbatron-integration-local" },
      // `index.build` on a new canonical tree, `index.purge` for archived Projects (indexer).
      { "binding": "INDEXING", "queue": "rhumbatron-indexing-local" }
    ],
    // Poison commands (AGENTS.md section 42.7). This consumer has no dead-letter Queue of its own:
    // a storage failure retries a bounded number of times, then the message is dropped and logged.
    "consumers": [
      {
        "queue": "rhumbatron-dead-letter-local",
        "max_batch_size": 5,
        "max_retries": 5
      }
    ]
  },
  // Clef-flash for ambiguous wakeups only (AGENTS.md section 31.2), capped per day.
  "ai": { "binding": "AI" },
  // analytics-projector (AGENTS.md section 41.1): lifecycle Events as data points, own dataset.
  "analytics_engine_datasets": [
    { "binding": "EVENT_METRICS", "dataset": "rhumbatron_event_metrics_local" }
  ]
}
