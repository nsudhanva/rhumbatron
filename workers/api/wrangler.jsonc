// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-api",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:5173",
    "CLERK_ALLOW_MISSING_AZP": "true",
    // Platform admin user IDs, a JSON array (ADR 0033). Terraform sets var.platform_admin_user_ids.
    // Local development has no platform admin.
    "PLATFORM_ADMIN_USER_IDS": "[]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhumbatron-control-local",
      "database_id": "local",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "rhumbatron-evidence-local" }],
  // Durable Objects live in the coordinator Worker. Run both with multi-worker `wrangler dev`.
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOT",
        "class_name": "ProjectRootDO",
        "script_name": "rhumbatron-coordinator"
      },
      {
        "name": "PROJECT_VIEW",
        "class_name": "ProjectViewDO",
        "script_name": "rhumbatron-coordinator"
      }
    ]
  },
  // ChangeWorkflow runs in the integration Worker.
  "workflows": [
    {
      "name": "rhumbatron-change-workflow-local",
      "binding": "CHANGE_WORKFLOW",
      "class_name": "ChangeWorkflow",
      "script_name": "rhumbatron-integration"
    }
  ],
  // Project source provisioning commands for the integration Worker (ADR 0010). Dead-letter retry
  // sends a command back to its original Queue: integration or agent wakeups.
  "queues": {
    "producers": [
      { "binding": "INTEGRATION_COMMANDS", "queue": "rhumbatron-integration-local" },
      { "binding": "AGENT_WAKEUPS", "queue": "rhumbatron-agent-wakeups-local" }
    ]
  },
  "services": [
    // Sandbox smoke check RPC.
    { "binding": "AGENTS", "service": "rhumbatron-agents" },
    // Approval and promotion RPC (ADR 0013).
    { "binding": "INTEGRATION", "service": "rhumbatron-integration" }
  ]
}
