// Local development configuration only. Terraform owns the remote Worker.
// Keep binding names identical to infrastructure/terraform.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rhumbatron-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // The Agents SDK and Pi need Node.js APIs.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SERVICE_NAME": "rhumbatron-agents",
    "AI_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "rhumbatron-models-dev"
  },
  // Workers AI: Clef-flash routing decisions only, capped per day (rule 50).
  "ai": { "binding": "AI" },
  // Context Packet snapshots: context/<project>/<change>/<task>/<hash>.json (AGENTS.md 27.5).
  // Read-only canonical source for agents (ADR 0010).
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "rhumbatron-projects-local" }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "rhumbatron-evidence-local" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhumbatron-control-local",
      "database_id": "local",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "durable_objects": {
    "bindings": [
      // One AgentDO per logical agent identity (AGENTS.md section 13.4).
      { "name": "AGENT", "class_name": "AgentDO" },
      // One Sandbox container per Project, hosted by the Sandbox Worker (ADR 0012).
      { "name": "SANDBOX", "class_name": "Sandbox", "script_name": "rhumbatron-sandbox" },
      {
        "name": "PROJECT_ROOT",
        "class_name": "ProjectRootDO",
        "script_name": "rhumbatron-coordinator"
      },
      {
        "name": "RESOURCE_SHARD",
        "class_name": "ResourceShardDO",
        "script_name": "rhumbatron-coordinator"
      }
    ]
  },
  // AGENTS.md section 20: one consumer for all agent wakeups, never one Queue per Agent.
  "queues": {
    "consumers": [
      {
        "queue": "rhumbatron-agent-wakeups-local",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "rhumbatron-dead-letter-local"
      }
    ]
  },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "rhumbatron_metrics_local" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentDO"] }]
}
