{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["cf", "gitleaks", "terraform", "tflint"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": ["wrangler"]
    },
    "apps/web": {
      "ignoreDependencies": ["cloudflare"]
    },
    "workers/*": {
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/*": {}
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignore": ["fixtures/**"]
}
