{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks", "cf"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "services/*/*.ts", "services/*/src/main.ts", "services/*/test/*.ts"]
    },
    "apps/web": {},
    "workers/apps": {
      "entry": ["src/platform/workerd.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "workers/*": {
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/*": {},
    "services/git": {},
    "services/sandboxd": {}
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
