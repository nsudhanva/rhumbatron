{
  "name": "rhumbatron",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "stack:env": "bun scripts/local-env.ts",
    "stack:up": "bun scripts/local-env.ts && docker compose up -d --build && bun scripts/trust-local-ca.ts --check",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f --tail 100",
    "stack:trust": "bun scripts/trust-local-ca.ts",
    "smoke": "bun scripts/smoke.ts",
    "docs:deploy": "bun scripts/deploy-docs.ts",
    "test:critical": "turbo test:critical && vitest run --dir scripts",
    "check": "bun run lint && bun run typecheck && bun run check:guardrails && bun run check:migrations && bun run check:deps && bun run check:secrets",
    "check:guardrails": "bun scripts/check-guardrails.ts",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:deps": "knip && sherif",
    "check:secrets": "gitleaks git --redact --no-banner && gitleaks git --staged --redact --no-banner",
    "prepare": "lefthook install",
    "e2e": "bun scripts/e2e.ts",
    "journeys": "bun scripts/journeys.ts",
    "cleanup:projects": "bun scripts/cleanup-projects.ts",
    "test:ui": "playwright test",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "chrome-launcher": "1.2.1",
    "knip": "6.40.0",
    "lefthook": "2.2.1",
    "lighthouse": "12.6.1",
    "sherif": "1.13.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
